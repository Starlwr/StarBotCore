{
  "fieldParity": {
    "meta": {
      "title": "字段校验",
      "basePath": ["starbot", "field-parity"],
      "groups": [
        {
          "id": "fields",
          "title": "字段",
          "fields": [
            {"key": "optional", "type": ["string", "null"]},
            {"key": "recipients", "type": "map", "keyMeta": {"label": "收件邮箱", "format": "email"}, "values": {"type": "string"}},
            {"key": "profiles", "type": "map", "keyMeta": {"label": "配置名", "options": [{"value": "local"}]},
             "values": {"type": "string"}}
          ]
        }
      ]
    },
    "values": {
      "optional": null,
      "recipients": {"not-an-email": "note"},
      "profiles": {"unknown": "note"}
    },
    "errorPaths": [
      ["starbot", "field-parity", "recipients", "not-an-email"],
      ["starbot", "field-parity", "profiles", "unknown"]
    ]
  },
  "accessPasswords": [
    {"name":"空字符串可清空密码","value":""},
    {"name":"7 位新密码","value":"Aa1!xyz","message":"访问密码不能少于 8 个字符"},
    {"name":"8 位新密码","value":"Aa1!xyza"},
    {"name":"32 位新密码","value":"Ab3!XXXXXXXXXXXXXXXXXXXXXXXXXXXX"},
    {"name":"33 位新密码","value":"Ab3!XXXXXXXXXXXXXXXXXXXXXXXXXXXXX","message":"访问密码不能超过 32 个字符"},
    {"name":"JSON 数字不是密码文本","value":12345678,"message":"访问密码必须为文本"},
    {"name":"JSON null 不是密码文本","value":null,"message":"访问密码必须为文本"},
    {"name":"中文密码","value":"Aa1!密码abc","message":"访问密码只能使用英文字母、数字和半角符号"}
  ],
  "context": {
    "parent": {
      "models": {
        "main": {},
        "backup": {}
      },
      "limit": 10,
      "external": [
        "a",
        "b"
      ],
      "enabled": true,
      "pending": "${PROXY_ENABLED}"
    },
    "current": {},
    "document": {}
  },
  "placeholders": [
    {"value": "${PORT}", "expected": true},
    {"value": "${PORT:7827}", "expected": true},
    {"value": "${PORT:${DEFAULT_PORT:7827}}", "expected": true},
    {"value": "http://${HOST}:${PORT:7827}", "expected": true},
    {"value": "${PORT", "expected": false},
    {"value": "${PORT:${DEFAULT_PORT:7827}", "expected": false},
    {"value": "${HOST}:${PORT", "expected": false},
    {"value": "${}", "expected": false},
    {"value": "${:7827}", "expected": false},
    {"value": "${ }", "expected": false},
    {"value": "\\${PORT}", "expected": false},
    {"value": 7827, "expected": false}
  ],
  "rules": [
    {"name":"very close is not a multiple","value":1.0000000001,"rule":{"rule":"multipleOf","value":1},"expected":false},
    {"name":"decimal exact multiple","value":0.3,"rule":{"rule":"multipleOf","value":0.1},"expected":true},
    {"name":"exponent decimal multiple","value":3e-7,"rule":{"rule":"multipleOf","value":1e-7},"expected":true},
    {"name":"zero is a multiple of a fractional step","value":0,"rule":{"rule":"multipleOf","value":0.001},"expected":true},
    {"name":"ISO signed time parts","value":"PT1H-30M","rule":{"rule":"durationRange","min":"30m","max":"30m"},"expected":true},
    {"name":"negative subsecond not positive","value":"PT-0.000000001S","rule":{"rule":"positiveDuration"},"expected":false},
    {"name":"malformed duration is not positive","value":"P1DT","rule":{"rule":"positiveDuration"},"expected":false},
    {"name":"nanosecond precision at long limit","value":"PT9223372036854775807.000000001S","rule":{"rule":"durationRange","min":"PT9223372036854775807S","max":"PT9223372036854775807S"},"expected":false},
