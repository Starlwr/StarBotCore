    {
      "id": "ai",
      "title": "AI",
      "description": "AI 相关设置",
      "path": [
        "ai"
      ],
      "restartRequired": true,
      "fields": [
        {
          "key": "default-model",
          "label": "默认模型名称",
          "description": "默认使用的模型，配置多个模型时必须指定",
          "type": "string",
          "optionsFrom": {
            "scope": "parent",
            "path": [
              "models"
            ],
            "source": "keys"
          },
          "requiredWhen": {
            "scope": "parent",
            "path": [
              "models"
            ],
            "op": ">",
            "value": 1,
            "measure": "size"
          },
          "validators": [
            {
              "rule": "keyInMap",
              "scope": "parent",
              "path": [
                "models"
              ],
              "allowUnset": true,
              "message": "默认模型必须是模型列表中已配置的模型"
            }
          ],
          "nullable": true
        },
        {
          "key": "models",
          "label": "模型配置列表",
          "type": "map",
          "keyMeta": {
            "label": "模型配置名称",
            "nonBlank": true
          },
          "values": {
            "type": "object",
            "fields": [
              {
                "key": "provider",
                "label": "接口协议",
                "description": "模型的接口协议，按服务商文档填写",
                "type": "string",
                "required": true,
                "options": [
                  {
                    "label": "OpenAI 兼容接口",
                    "value": "OPENAI"
                  },
                  {
                    "label": "Anthropic 兼容接口",
                    "value": "ANTHROPIC"
                  }
                ]
              },
              {
                "key": "base-url",
                "label": "接口地址",
                "description": "模型服务的 API 地址，按服务商文档填写",
                "type": "string",
                "required": true,
                "nonBlank": true,
                "format": "http-base-url"
              },
              {
                "key": "api-key",
                "label": "API Key",
                "description": "模型服务的访问密钥",
                "type": "string",
                "required": true,
                "nonBlank": true,
                "ui": {
                  "widget": "password"
                }
              },
              {
                "key": "model",
                "label": "服务端模型名称",
                "description": "服务商的模型标识，例如 deepseek-flash，按服务商文档填写",
                "type": "string",
                "required": true,
                "nonBlank": true
              },
              {
                "key": "temperature",
                "label": "采样温度",
                "description": "回答的随机程度，越低越稳定，留空时使用服务商默认值",
                "type": "number",
                "nullable": true
              },
              {
                "key": "max-tokens",
                "label": "最大输出 token 数",
                "description": "单次回答的最大输出 Token 数",
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647,
                "ui": {
                  "unit": "K"
                }
              },
              {
                "key": "timeout",
                "label": "网络请求超时",
                "description": "等待模型服务响应的最长时间",
                "type": "integer",
                "minimum": 1,
                "maximum": 600,
                "ui": {
                  "unit": "秒"
                }
              },
              {
                "key": "max-retries",
                "label": "网络请求重试次数",
                "description": "请求失败后的最大重试次数，0 表示不重试",
                "type": "integer",
                "minimum": 0,
                "maximum": 1024
              },
              {
                "key": "structured-output-max-repeat-attempts",
                "label": "结构化输出修复次数",
                "description": "结构化数据格式错误时的最大修正次数，0 表示不修正",
                "type": "integer",
                "minimum": 0,
                "maximum": 1024
              },
              {
                "key": "headers",
                "label": "自定义请求头",
                "description": "自定义 HTTP 请求头，例如额外认证字段",
                "type": "map",
                "keyMeta": {
                  "label": "请求头名称",
                  "nonBlank": true
                },
                "values": {
                  "type": "string"
                }
              },
              {
                "key": "extra-body",
                "label": "额外请求体参数",
                "description": "额外请求体参数，仅 OpenAI 协议生效",
                "type": "map",
                "keyMeta": {
                  "label": "参数名",
                  "nonBlank": true
                },
                "values": {
                  "type": "any"
                }
              }
            ]
          }
        }
      ]
    },
